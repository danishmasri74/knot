{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knot",
  "version": "0.5.0",
  "identifier": "com.knot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knot",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://img.youtube.com; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: https://youtube.com/oembed https://www.youtube.com/oembed; worker-src 'self' blob:; frame-src blob: 'self' https://www.youtube.com/embed/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBOTEwQjRENEI5RjE4QzQKUldURUdKOUxUUXVSR241UVgvNWp4NTgyb3ZyWmJtL3lia3hHL0ZYdVZ2d3JWSk9Jdlo1VHo3cTMK",
      "endpoints": [
        "https://github.com/knot-desktop/knot-releases/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A local home for connected ideas",
    "publisher": "Knot",
    "copyright": "© 2026 Knot",
    "homepage": "https://github.com/knot-desktop/knot-releases",
    "fileAssociations": [
      {
        "ext": ["knotbook"],
        "name": "Knot.Notebook",
        "description": "Knot notebook",
        "role": "Editor"
      }
    ],
    "resources": {
      "icons/knotbook/knotbook.ico": "knotbook.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "template": "installer/knot.nsi",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "compression": "lzma",
        "displayLanguageSelector": false
      }
    }
  }
}
