{
  "name": "knot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "checks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/checks.ps1",
    "update:running": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-running.ps1",
    "version:set": "node scripts/set-version.mjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/verify-topic-model.mjs && tsc -b && vite build",
    "check": "tsc -b",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests docs *.json *.ts *.md"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@blocksuite/affine-shared": "0.19.5",
    "@blocksuite/block-std": "0.19.5",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@huggingface/transformers": "3.8.1",
    "@mozilla/readability": "^0.6.0",
    "@preact/signals-core": "1.14.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@toeverything/theme": "1.1.23",
    "linkedom": "^0.18.15",
    "lit": "3.3.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@blocksuite/icons": "2.1.75"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@blocksuite/blocks@0.19.5": "patches/@blocksuite__blocks@0.19.5.patch",
      "@blocksuite/block-std@0.19.5": "patches/@blocksuite__block-std@0.19.5.patch",
      "@blocksuite/data-view@0.19.5": "patches/@blocksuite__data-view@0.19.5.patch"
    }
  }
}
